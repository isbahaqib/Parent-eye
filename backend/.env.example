PORT=3001
# Primary browser origin (also listed in default CORS allowlist for localhost:3000–3005)
FRONTEND_URL=http://localhost:3000
# Optional: extra origins, comma-separated (e.g. https://your-app.vercel.app)
# CORS_ORIGINS=
JWT_SECRET=replace-with-a-secure-random-string
# SQLite database file (relative to backend folder)
DATABASE_URL="file:./dev.db"
